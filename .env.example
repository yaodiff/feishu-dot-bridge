# Copy to .env locally; never commit real secrets. Node 24: node --env-file=.env dist/src/main.js
PUBLIC_URL=https://bridge.example.com
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/bridge.sqlite
FEISHU_APPS_FILE=./config/feishu-apps.json
# Established OAuth2.1 authorization server, JWT access tokens <=1h, scope bridge:use
OAUTH_ISSUER=https://your-idp.example.com
OAUTH_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# Exact hostnames copied from verified actual ChatGPT callback destinations; never use *
CALLBACK_HOSTS=callback.invalid
ALLOWED_ORIGINS=https://chatgpt.com
ALLOWED_HOSTS=bridge.example.com
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
STORAGE_KEY=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
