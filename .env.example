# Personal installation; no shared service, signup, external IdP, or public listener.
# Prefer `npm run init:personal` ON YOUR HOST to generate unique local files; it refuses overwrite.
AUTH_MODE=personal-tunnel
INSTALLATION_ID=
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/personal.sqlite
FEISHU_APP_FILE=./config/feishu-app.json
# Exactly one env value OR private file per secret. No default/shared token.
BRIDGE_TOKEN_FILE=./config/bridge-token
STORAGE_KEY_FILE=./config/storage-key
FEISHU_APP_SECRET=
# Set exact official callback hostname after verified fail-closed bootstrap.
CALLBACK_HOSTS=callback.invalid
ALLOWED_ORIGINS=https://chatgpt.com
# Official tunnel-client, in its OWN configuration (not a bridge variable):
# MCP_EXTRA_HEADERS="X-Bridge-Token: file:/absolute/private/config/bridge-token"
# Verify owner-only Tunnel ACL and Events+Tunnel+UI None on your target host before use.
# Optional new image intake requires Linux /usr/bin/prlimit and explicit processing approval.
# FEISHU_MEDIA_INPUT=images-v1
